# Cesium Ion Access Token (Required for Photogrammetry & 3D World Terrain)
# Get a free access token from https://ion.cesium.com/
CESIUM_ION_TOKEN=your_cesium_ion_token_here

# Google Photorealistic 3D Tiles Key (Optional)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Backend Database Configuration (PostgreSQL + PostGIS)
# Format: postgresql://username:password@localhost:5432/sih_3d_cadastre
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sih_3d_cadastre

# API Server Configuration
PORT=8000
HOST=0.0.0.0
